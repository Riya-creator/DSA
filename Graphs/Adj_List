#include<iostream>
#include<queue>
using namespace std;
class Node {
    public:
    int node;
    Node * next =NULL;
    Node( int v): node(v){}
};
class graph{
    public:
    int v;
    Node ** g;
    graph(int v): v(v){
        g= new Node* [v];
        for( int i=0; i<v; i++)
        g[i] = NULL;
    }
    void dir(){
        cout<<"Enter edges for the directed graph\n";
        int n, n1, n2;
        cin>>n;
        cout<<"\n taking edges\n";
        for( int i=0; i<n; i++){
            cin>>n1>>n2;
            Node *nn= new Node(n2);
            nn->next =g[n1];
            g[n1] = nn;
        }
    }
    
    void dfs(bool ar[], int n){
        ar[n] = true;
        Node * temp = g[n];
        cout<<n<<" ";
        while(temp){
            if( ar[temp->node]== false) dfs(ar, temp->node);
            temp= temp->next;
        }
    }
};
int main(){
    graph d(4);
    //node vary from 0 to 3 
    d.dir();
    bool ar[4]= {false};
    for (int i = 0; i < 4; i++) {
        if (!ar[i]) 
            d.dfs(ar, i);
    }
    d.bfs(4);

}
