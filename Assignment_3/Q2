include <iostream>
using namespace std;

class stack {
    int len, top=-1 ;
    int a[10];
    public:
    stack(int n){
        len =n;
    }
    void push(){
        int n;
        cout<<"Enter the value to puush in stack:";
        cin>>n;
        if(top>=9){
            cout<<"stack overflowed";
            return;
        }
        else {
            top++;
            a[top]= n;
        }
    }
    void pop(){
        cout<<"the topmost value poped from the stakc is: "<<a[top];
        if( top>0){
            top--;
        }
        else cout<<"stack is already empty\n";
    }
    void isEmpty(){
        if(top==-1)
        cout<<"stack is empty ";
        else cout<<"statck contain some elements\n";
    }
    void isFull()
    {
        if( top==len-1)
        cout<<"stack is full";
        else cout<<"stack can gain some more elements\n";
    }
    void display(){
        for( int i=top; i>=0; i--){
            cout<<a[i]<<"   ";
        }
    }
    void peek(){
        cout<<"the topmost element is:"<<a[top];
    }
};
