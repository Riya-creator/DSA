#include <iostream>
using namespace std;
class queue{
    int *a, f=-1, r=-1,len;
    public:
    queue(int n){
        a=new int [n];
        len=n;
    }
    bool isEmpty(){
        if(f==-1 &&r==-1)
        return true;
        return false;
    }
    bool isFull(){
        if((r+1)%len==f )
        return true;
        return false;
    }
    void enqueue(int n){
        if(isFull()){
            cout<<"\nNo Space the insert the value\n";
            return ;
        }
        if (f == -1 && r == -1)

        {
            f++;r++;
        }
        else r=(r+1)%len;
        a[r]=n;
    }
    void dequeue(){
        if(isEmpty()){
            cout<<"\nIt doesn't contain any elements...\n";
            return;
        }
        if(f==r){
            f=-1;r=-1;
        }
        else f=(f+1)%len;
        
    }
    void display(){
        if(isEmpty())
        {
            cout<<"\nIt is empty nothing to diplay\n";
            return;
        }
        int i=f;
        do{
            cout<<a[i]<<" ";
            i= (i+1)%len;
        }while(i!=((r+1)%len));
        cout<<endl;
    }
    int peek(){
        if(isEmpty()){
            cout<<"No element in this";
            return 0;
        }
        return a[f];
    }
    ~queue(){
        delete [] a;
        }
};
class stack{
    queue *q,*h;
    int len;
    public:
    stack(int n){
        len=n;
        q= new queue(n);
        h= new queue(n);
    }
    void input(){
        if(q->isFull())
        {
            cout<<"Noo space left...";
            return;
        }
        int m;
        cout<<"Enter the values of stack";
            cin>>m;
            while(!q->isEmpty()){
                h->enqueue(q->peek());
                q->dequeue();
            }
            q->enqueue(m);
            while(!h->isEmpty()){
                q->enqueue(h->peek());
                h->dequeue();
            }
    }
    void display(){
        q->display();
    }
    bool isEmpty(){
        return q->isEmpty();
    }
    bool isFull(){
        return q->isFull();
    }
    int top(){
        return q->peek();
    }
    void pop(){
        q->dequeue();
    }
    ~stack(){
        delete[] q,h;
}
};
