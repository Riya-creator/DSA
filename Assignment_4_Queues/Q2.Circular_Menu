#include<iostream>
using namespace std;

class Circlular{
    int *a, n, f=-1, r=-1;
    public:
    Circlular(int num){
        a= new int[num];
        n= num;
    }
    void enqueue(){
        if(isFull()){
            cout<<"\nQueue is full no more entry allowed!!\n";
            return;
        }
        int m;
            cout<<"\nEnter the value of insert \n";
            cin>>m;
        if(f==-1 &&r==-1){
            f++;
            r++;
        }
        else {
            r= (r+1)%n;
        }
        a[r]=m;
    }
    void dequeue(){
        if(isEmpty()){
            cout<<"\nQueue is Empty\n ";
            return;
        }
        if(f==r){
            f=r=-1;
        }
        else
        f= (f+1)%n;
    }
    bool isEmpty(){
        if( f==-1 &&r==-1)
        return true;
        else return false;
    }
    bool isFull(){
        return ( (r+1) % n == f );
    }
    void display(){
        int i = f;
        do {
            cout << a[i] << " ";
            i = (i+1)%n;
            } while(i != (r+1)%n);
        cout << endl;
    }
    void peek(){
        if(isEmpty()){
            cout<<"\nIt's Empty no elements..\n";
        }
        else cout<<"\n"<<a[f]<<endl;
    }
};
int main()
{
    int n, choice;
    cout<<"enter the max number of the elements u need to store in the queue: ";
    cin>>n;
    Circlular Q(n);
    while(1){
    cout<<"choose from this menu to implement the operation u wanna on this queue\n1.Enqueue\n2.Dequeue\n 3.Empty check\n 4. full check\n 5. Display \n 6.Peek\n 7.Exit\n";
    cin>>choice;
    switch(choice){
        case 1:
        Q.enqueue();
        break;
        case 2:
        Q.dequeue();
        break;
        case 3:
        if(!Q.isEmpty()){
            cout<<"It contians some numbers\n";
        }
        else cout<<"It is Empty!!..";
        break;
        case 4:
        if(Q.isFull())
        cout<<"Full ....!\n";
        else cout<<"Need more elements\n";
        break;
        case 5:
        Q.display();
        break;
        case 6:
        Q.peek();
        break;
        case 7:
        return 0;
    }
    }
    return 0;
}
