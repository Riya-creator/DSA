#include <iostream>
using namespace std;

class node {
public:
    int val;
    node* next;
    node* prev;

    node(int v) : val(v), next(nullptr), prev(nullptr) {}
};

class dll {
    node* tail;
public:
    node* head;
    dll() {
        head = tail = nullptr;
    }

    void insertst(int val) {
        node* nn = new node(val);
        if (!head) {
            head = tail = nn;
            head->next = head;
            head->prev = head;
            return;
        }
        nn->next = head;
        nn->prev = tail;
        tail->next = nn;
        head->prev = nn;
        head = nn;
    }

    void end(int val) {
        node* nn = new node(val);
        if (!head) {
            head = tail = nn;
            head->next = head;
            head->prev = head;
            return;
        }
        nn->prev = tail;
        nn->next = head;
        tail->next = nn;
        head->prev = nn;
        tail = nn;
    }

    void insertionafter(int val, int af) {
        if (!head) return;
        node* ptr = head;
        do {
            if (ptr->val == af) {
                node* nn = new node(val);
                nn->next = ptr->next;
                nn->prev = ptr;
                ptr->next->prev = nn;
                ptr->next = nn;
                if (ptr == tail) tail = nn;
                return;
            }
            ptr = ptr->next;
        } while (ptr != head);
    }

    void insertionbef(int val, int bef) {
        if (!head) return;
        node* ptr = head;
        do {
            if (ptr->val == bef) {
                node* nn = new node(val);
                nn->next = ptr;
                nn->prev = ptr->prev;
                ptr->prev->next = nn;
                ptr->prev = nn;
                if (ptr == head) head = nn;
                return;
            }
            ptr = ptr->next;
        } while (ptr != head);
    }

    void deletion(int value) {
        if (!head) return;

        node* ptr = head;
        do {
            if (ptr->val == value) {
                if (ptr == head && ptr == tail) {
                    delete ptr;
                    head = tail = nullptr;
                    return;
                }
                ptr->prev->next = ptr->next;
                ptr->next->prev = ptr->prev;

                if (ptr == head) head = ptr->next;
                if (ptr == tail) tail = ptr->prev;

                delete ptr;
                return;
            }
            ptr = ptr->next;
        } while (ptr != head);
    }
    void show() {
        if (!head) {
            cout << "List is empty.\n";
            return;
        }

        node* ptr = head;
        cout << "Circular DLL: ";
        do {
            cout << ptr->val << " ";
            ptr = ptr->next;
        } while (ptr != head);
        cout << endl;
    }
    //ques3
    
    void count() {
        if (!head) {
            cout << "List is empty.\n";
            return;
        }
        node* ptr = head;
        cout << "Total Number of nodes: ";
        int count=0;
        do {
            ptr = ptr->next;
            count++;
        } while (ptr != head);
        cout<<count<<endl;;
    }
    //ques4
    void palindrome(node *head){
        if(head==NULL ||head->next==NULL) return true;
        node *fp=head, *sp=head->prev;
        while(fp!=sp || sp->next!= fp){
            if(fp->val!= sp->val) {
                cout<<"Not a palindrome...\n";
                return;
            }
            fp=fp->next;
            sp=sp->prev;
        }
        cout<<"Palindrome!!\n";
    }
};
//ques 5
bool isCircle(node *head){
    if(head==NULL) return true;
    
    node *temp= head->next;
    while(temp!= head || temp!= NULL){
        temp= temp->next;
    }
    return temp==head;
}

int main() {
    dll dl;
    dl.insertst(10);
    dl.insertst(20);
    dl.end(30);
    dl.insertionafter(25, 20);
    dl.insertionbef(5, 10);
    dl.deletion(25);
    dl.show();
    dl.count();
    if(isCircle(dl.head)) cout<<"yes\n";
    else cout<<"Nooo";
    dl.palindrome();
}
